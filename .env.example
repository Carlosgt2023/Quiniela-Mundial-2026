# Copia este archivo como .env para desarrollo local
# En Railway, configura estas variables en el panel de Variables

# Contraseña del administrador (cámbiala antes de publicar)
ADMIN_PASSWORD=admin2026

# Ruta de la base de datos
# Local: déjala vacía (usará db/quiniela.db por defecto)
# Railway: /data/quiniela.db  (apunta al volumen persistente)
DB_PATH=/data/quiniela.db

# Puerto (Railway lo setea automáticamente)
PORT=3000

# ── Marcadores en vivo (API-Football / api-sports.io) ────────────
# Tu API key de https://dashboard.api-football.com/ (o api-sports.io).
# Sin token, la sincronización en vivo queda desactivada y los
# marcadores se siguen ingresando a mano.
APIFOOTBALL_KEY=

# ID de la liga del Mundial en API-Football (Copa del Mundo = 1)
WC_LEAGUE_ID=1

# Pon "false" para desactivar la sincronización aunque exista la key
LIVE_SYNC_ENABLED=true

# Sondeo adaptativo (en ms). Pensado para el plan gratuito (100 req/día):
#   LIVE = hay partidos en vivo · NEAR = hay partidos hoy sin vivo · IDLE = sin partidos
LIVE_SYNC_LIVE_MS=600000     # 10 min
LIVE_SYNC_NEAR_MS=1800000    # 30 min
LIVE_SYNC_IDLE_MS=7200000    # 120 min
# Freno: si la cuota diaria restante baja de este número, pausa el sondeo
LIVE_SYNC_SAFETY=5
